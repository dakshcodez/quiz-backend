# Supabase PostgreSQL connection string (URI).
# Supabase Dashboard → Project Settings → Database → Connection string (URI).
# Use connection pooler (port 6543) for server apps.
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT signing secret. Use a long random string in production.
JWT_SECRET=your-super-secret-key-change-in-production

# Server port (default 8080).
PORT=8080

# JWT token expiry in hours (default 24).
JWT_EXPIRY_HOURS=24

# Database query timeout in seconds (default 10).
DB_TIMEOUT_SEC=10
